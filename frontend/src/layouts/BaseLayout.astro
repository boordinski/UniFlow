---
import "../styles/global.css";
interface Props {
  title?: string;
}
const { title = "UniFlow — Mobility Intelligence" } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="UniFlow: previsione e analisi della pressione sulla mobilità universitaria."
    />
    <meta name="theme-color" content="#0b1220" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
